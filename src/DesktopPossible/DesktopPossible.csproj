<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<AssemblyName>DesktopPossible</AssemblyName>
		<RootNamespace>Desktop_Frames</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>True</UseWindowsForms>
		<!-- Version is injected by package.ps1 / CI via -p:Version; this is the local-dev fallback. -->
		<Version Condition="'$(Version)' == ''">0.0.1-dev</Version>
		<ApplicationIcon>Resources\logo2.ico</ApplicationIcon>
		<!-- Memory: workstation GC and return unused memory to the OS to keep the footprint low. -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<RetainVMGarbageCollection>false</RetainVMGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="file-WhiteX.png" />
		<None Remove="fileX.png" />
		<None Remove="folder-White.png" />
		<None Remove="folder-WhiteX.png" />
		<None Remove="folder.png" />
		<None Remove="folderX.png" />
		<None Remove="portal.png" />
		<None Remove="Resources\dot.png" />
		<None Remove="Resources\dragon.png" />
		<None Remove="Resources\empty.png" />
		<None Remove="Resources\Feed.png" />
		<None Remove="Resources\link-White.png" />
		<None Remove="Resources\logo_blue.ico" />
		<None Remove="Resources\spotify-White.png" />
		<None Remove="Resources\steam-White.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\logo2.ico" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Resources\empty.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\dragon.png" />
		<EmbeddedResource Include="Resources\logo1.png" />
		<EmbeddedResource Include="Resources\steam-White.png" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources\Feed.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<Resource Include="Resources\dot.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Resources\file-WhiteX.png" />
		<Resource Include="Resources\fileX.png" />
		<Resource Include="Resources\folder-White.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Resources\folder-WhiteX.png" />
		<Resource Include="Resources\folder.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Resources\folderX.png" />
		<EmbeddedResource Include="Resources\logo_blue.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<Resource Include="Resources\link-White.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
		<Resource Include="Resources\portal.png" />
		<Resource Include="Resources\spotify-White.png">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
