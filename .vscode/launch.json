{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch DesktopFramesPossible (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build (Debug)",
      "program": "${workspaceFolder}/.build/DesktopFramesPossible/bin/Debug/net8.0-windows7.0/DesktopFramesPossible.exe",
      // cwd = exe dir: the app is portable and writes its config/profiles beside
      // the exe, so debug state stays sandboxed inside gitignored .build/
      "cwd": "${workspaceFolder}/.build/DesktopFramesPossible/bin/Debug/net8.0-windows7.0",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Attach to running DesktopFramesPossible",
      "type": "coreclr",
      "request": "attach",
      "processName": "DesktopFramesPossible"
    }
  ]
}
